# 3D 桌宠 · 本机环境配置模板（ADR 0018 D1）
#
# 用法：复制为 `.env` 后按需修改。`.env` 已被 .gitignore 排除，不会入库。
# 优先级：进程环境变量 > `.env` > 代码默认值。也就是说 `setx` / 终端里的同名变量
# 永远压过本文件；`.env` 只负责补空缺。
#
# 语法：KEY=VALUE；`#` 开头是注释；值可用单/双引号包裹（双引号内支持 \n \r \t 转义）；
# 未加引号的值遇到"空白 + #"视为行尾注释。本文件只被本地读取，不联网、不执行。

# ---------------------------------------------------------------------------
# 本地 LLM（Ollama，契约 §9.4 / ADR 0015 D1）
# ---------------------------------------------------------------------------
# 只允许回环地址；非回环会在启动期抛 ConfigError（§10.2 的零出站守卫）。
PET_LLM_URL=http://127.0.0.1:11434
# 必须事先 `ollama pull` 到本地；应用不会自动拉取（ADR 0015 D1.2）。
PET_LLM_MODEL=qwen3:4b
# 健康检查超时（毫秒），默认 800。
#PET_LLM_HEALTH_TIMEOUT_MS=800
# 单轮推理硬超时（毫秒），默认 8000；同时是 thinking 的总预算（§9.1 / §12）。
#PET_LLM_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# 本地 TTS（GPT-SoVITS，契约 §7.4 / ADR 0015 D2）
# ---------------------------------------------------------------------------
PET_TTS_URL=http://127.0.0.1:9880
# 参考音频：3–10 秒、干净人声。必须是 GPT-SoVITS 进程可见的**绝对路径**；
# 留空则默认 <工程根目录>/data/ref/kaiyi.wav。
#PET_TTS_REF_AUDIO=D:\aa3dpet-app\data\ref\kaiyi.wav
# 参考音频的**逐字文本**（必填）：必须与 wav 内容逐字一致，否则音色/韵律会跑偏。
# 留空 = TTS 判定"未配置"：不发起任何 HTTP，回复退化为字幕 + 无语音（§11）。
# 若文本含 `#`（前面有空格）或首尾空格，请用双引号包裹整段文本。
PET_TTS_PROMPT_TEXT=
# 参考音频/参考文本的语种（ADR 0019）。本机凯伊参考音频是**日文**，所以默认 ja。
# 换参考音频语种时必须同时改本行与 PET_TTS_PROMPT_TEXT（两者必须逐字一致）。
PET_TTS_PROMPT_LANG=ja
# 要合成的回复文本语种。本轮起角色只用**日文**回复 → ja（ADR 0019 / ADR 0022）。
# v2ProPlus 支持跨语种（例如日文参考 + 中文合成）；本机参考音频与回复文本同为日文。
PET_TTS_TEXT_LANG=ja
# 支持的值：auto | auto_yue | en | zh | ja | yue | ko | all_zh | all_ja | all_yue | all_ko
# （all_* 表示"整段文本全是该语言"，用于纯语言文本；普通混合文本用 zh/ja/en/ko/yue）
# 超时（毫秒）。契约默认 3000 / 30000；CPU 非流式部署（本机）建议 15000 / 120000，
# 否则 v2ProPlus 冷静启动的第一句话必然超时（ADR 0015 D2.5）。
PET_TTS_FIRST_BYTE_TIMEOUT_MS=15000
PET_TTS_TOTAL_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# 资产与数据（可选覆盖；默认见 ADR 0009 / 0014）
# ---------------------------------------------------------------------------
# 模型（glTF 2.0 .glb），相对路径按工程根目录解析。
#PET_MODEL_PATH=CH0335.glb
# 嘴型图集（8×8）
#PET_MOUTH_ATLAS=Character_Mouth_Black-Due3Gpre.png
# 官方表情差分目录（ADR 0026 D6）：eyes_happy/eyes_shy/eyes_sad/eyes_surprised/blush 五张 PNG
# 目录为空时表情自动降级为"只变嘴型"，不影响启动与口型
#PET_EXPRESSIONS_DIR=D:\aa3dpet-app\data\expressions
# 数据目录（character-card.md / lines.json / ref/）
#PET_DATA_DIR=D:\aa3dpet-app\data
# 取景排除正则（窗口尺寸按"排除后"的包围盒计算）
#PET_FRAME_EXCLUDE=(weapon|prop|brush|outline)
# 配件隐藏正则；缺省与 PET_FRAME_EXCLUDE 同源（ADR 0014 D5）
#PET_HIDE_ATTACHMENTS=(weapon|prop|brush|outline)

# ---------------------------------------------------------------------------
# 本地记忆（SQLite，契约 §7.5 / ADR 0020）
# ---------------------------------------------------------------------------
# 记忆库文件。默认 <数据目录>/memory.db（即 data/memory.db，已加入 .gitignore）。
# 换路径用于隔离实验：改完重启生效（`.env` 只在启动时读一次）。
#PET_MEMORY_DB=D:\aa3dpet-app\data\memory.db
# 逃生口：设 1 则完全不打开数据库，提示词段 3 恒为"（无）"，对话其余行为不变。
#PET_MEMORY_DISABLE=0

# ---------------------------------------------------------------------------
# 仅诊断用途（不要用于日常/分发）
# ---------------------------------------------------------------------------
# Chromium 沙箱初始化被安全软件拦截时，设 1 可用 --no-sandbox 确认问题来源。
#PET_CHROMIUM_NO_SANDBOX=0
